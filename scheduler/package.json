{
	"name": "scheduler",
	"version": "1.0.0",
	"main": "index.ts",
	"license": "MIT",
  "bin": "build/index.js",
	"devDependencies": {
		"@types/node": "^16.10.1",
		"ts-node": "^10.2.1",
		"typescript": "^4.4.3"
	},
	"scripts": {
		"start": "ts-node -r dotenv/config index.ts",
		"build": "tsc -p tsconfig.json && pkg . && cp dist/scheduler /usr/local/bin/scheduler"
	},
	"dependencies": {
		"@types/node-schedule": "^1.3.2",
		"axios": "^0.21.4",
		"dayjs": "^1.10.7",
		"dotenv": "^10.0.0",
		"node-schedule": "^2.0.0",
		"pkg": "^5.3.2"
	},
	"pkg": {
		"scripts": "build/**/*.js",
		"targets": [
			"node12-linux-x64"
		],
		"outputPath": "dist"
	}
}
